{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capabilities for Piku Phase 2 multi-window desktop pet",
  "windows": ["pet", "bubble", "panel"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show"
  ]
}
